#!/usr/bin/env python3
"""Bob's read-only report on Claire's desk.db.

Generates a single static HTML file summarising money, decisions, risk/health,
and LLM cost — the things worth checking on regularly. Reads desk.db directly,
so it works whether Claire's services are up or down. Not scheduled; re-run by
hand (or ask Bob to) whenever you want a fresh snapshot:

    ~/claire_trading/bin/bob-dashboard

Writes to ~/claire_trading/var/bob-dashboard.html
"""
import html
import socket
import sqlite3
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DB = REPO / "var" / "desk.db"
OUT = REPO / "var" / "bob-dashboard.html"


def port_open(port):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.3)
    try:
        return s.connect_ex(("127.0.0.1", port)) == 0
    finally:
        s.close()


def esc(v):
    return html.escape(str(v)) if v is not None else ""


def money(v):
    if v is None:
        return "-"
    return f"${v:,.2f}"


def fetch(conn, sql, params=()):
    try:
        return [dict(r) for r in conn.execute(sql, params)]
    except sqlite3.OperationalError:
        return []


def stat_tile(label, value, sub=None, status=None):
    status_cls = f" status-{status}" if status else ""
    sub_html = f'<div class="tile-sub">{esc(sub)}</div>' if sub else ""
    return f"""
    <div class="tile{status_cls}">
      <div class="tile-label">{esc(label)}</div>
      <div class="tile-value">{esc(value)}</div>
      {sub_html}
    </div>"""


def empty_state(msg):
    return f'<div class="empty">{esc(msg)}</div>'


def table(headers, rows, empty_msg):
    if not rows:
        return empty_state(empty_msg)
    thead = "".join(f"<th>{esc(h)}</th>" for h in headers)
    trs = []
    for row in rows:
        tds = "".join(f"<td>{esc(c)}</td>" for c in row)
        trs.append(f"<tr>{tds}</tr>")
    return f"""<table><thead><tr>{thead}</tr></thead><tbody>{"".join(trs)}</tbody></table>"""


def build():
    if not DB.exists():
        print(f"No desk.db found at {DB}", file=sys.stderr)
        sys.exit(1)

    conn = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row

    api_up = port_open(7788)
    dash_up = port_open(7787)

    # ---- money -------------------------------------------------------
    accounts = fetch(conn, "SELECT id, broker, environment, base_currency FROM broker_accounts ORDER BY id")
    for a in accounts:
        bal = fetch(conn, "SELECT COALESCE(SUM(amount_base),0)/1e6 AS bal FROM cash_transactions WHERE account_id=?", (a["id"],))
        a["cash"] = bal[0]["bal"] if bal else 0.0

    total_cash = sum(a["cash"] for a in accounts)

    positions = fetch(conn, """
        SELECT p.account_id, i.ticker, i.currency, p.qty, p.cost_base, p.commissions
        FROM v_positions p JOIN instruments i ON i.id = p.instrument_id
        WHERE p.qty != 0 ORDER BY p.account_id, i.ticker
    """)

    share_pl = fetch(conn, """
        SELECT account_id, ticker, qty_open, open_cost, open_commissions, realized_pl
        FROM v_share_pl ORDER BY realized_pl DESC
    """)
    total_realized = sum(r["realized_pl"] or 0 for r in share_pl)

    # ---- decisions -----------------------------------------------------
    pending = fetch(conn, """
        SELECT id, ticker, kind, thesis_json, expires_at, created_at
        FROM work_items WHERE state='awaiting_approval' ORDER BY created_at DESC
    """)
    recent_items = fetch(conn, """
        SELECT id, ticker, kind, state, created_at, updated_at
        FROM work_items ORDER BY updated_at DESC LIMIT 20
    """)
    state_counts = fetch(conn, "SELECT state, COUNT(*) c FROM work_items GROUP BY state")

    thesis_outcomes = fetch(conn, """
        SELECT ticker, kind, state, arbiter_model, realized_pl, llm_cost
        FROM v_thesis_outcomes ORDER BY realized_pl DESC
    """)

    # ---- risk / health ---------------------------------------------------
    alerts = fetch(conn, """
        SELECT pa.id, i.ticker, pa.rule, pa.threshold, pa.armed, pa.last_fired_at
        FROM price_alerts pa JOIN instruments i ON i.id = pa.instrument_id
        ORDER BY pa.armed DESC, i.ticker
    """)
    health = fetch(conn, """
        SELECT service, checked_at, ok, detail FROM service_health
        WHERE checked_at = (SELECT MAX(checked_at) FROM service_health h2 WHERE h2.service = service_health.service)
        ORDER BY service
    """)
    stuck_orders = fetch(conn, """
        SELECT id, work_item_id, account_id, side, qty, status, expires_at
        FROM orders WHERE status IN ('pending_session','placed','partially_filled')
        ORDER BY expires_at
    """)

    # ---- cost --------------------------------------------------------
    cost_by_agent = fetch(conn, """
        SELECT agent_id, COUNT(*) calls, SUM(tokens_in) tin, SUM(tokens_out) tout,
               SUM(cost_usd) cost
        FROM agent_runs GROUP BY agent_id ORDER BY cost DESC
    """)
    total_cost = sum(r["cost"] or 0 for r in cost_by_agent)

    watchlist = fetch(conn, "SELECT ticker, exchange, note, added_at FROM watchlist ORDER BY ticker")

    conn.close()

    now = time.strftime("%Y-%m-%d %H:%M:%S %Z")

    tiles = "".join([
        stat_tile("Total cash", money(total_cash), sub=f"across {len(accounts)} paper accounts"),
        stat_tile("Realized P&L", money(total_realized)),
        stat_tile("Open positions", str(len(positions))),
        stat_tile("Awaiting your approval", str(len(pending)),
                   status="warning" if pending else "good"),
        stat_tile("LLM spend to date", money(total_cost)),
        stat_tile("claire-api :7788", "up" if api_up else "down",
                   status="good" if api_up else "critical"),
        stat_tile("dashboards :7787", "up" if dash_up else "down",
                   status="good" if dash_up else "critical"),
    ])

    acct_rows = [[a["broker"], a["environment"], money(a["cash"]), a["base_currency"]] for a in accounts]
    pos_rows = [[p["account_id"], p["ticker"], p["qty"], money(p["cost_base"]), money(p["commissions"])] for p in positions]
    pl_rows = [[r["account_id"], r["ticker"], r["qty_open"], money(r["open_cost"]), money(r["realized_pl"])] for r in share_pl]
    pending_rows = [[p["id"], p["ticker"], p["kind"], p["expires_at"] or "-"] for p in pending]
    recent_rows = [[r["id"], r["ticker"], r["kind"], r["state"], r["updated_at"]] for r in recent_items]
    outcome_rows = [[o["ticker"], o["kind"], o["state"], o["arbiter_model"] or "-", money(o["realized_pl"]), money(o["llm_cost"])] for o in thesis_outcomes]
    alert_rows = [[a["ticker"], a["rule"], a["threshold"], "armed" if a["armed"] else "disarmed", a["last_fired_at"] or "never"] for a in alerts]
    health_rows = [[h["service"], h["ok"], h["detail"] or "-"] for h in health]
    stuck_rows = [[s["id"], s["work_item_id"], s["side"], s["qty"], s["status"]] for s in stuck_orders]
    cost_rows = [[c["agent_id"], c["calls"], c["tin"] or 0, c["tout"] or 0, money(c["cost"])] for c in cost_by_agent]
    watch_rows = [[w["ticker"], w["exchange"], w["note"] or "-"] for w in watchlist]
    state_summary = ", ".join(f"{s['state']}: {s['c']}" for s in state_counts) or "no runs yet"

    html_out = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Claire — Bob's report</title>
<style>
  .viz-root {{
    color-scheme: light;
    --surface-1:      #fcfcfb;
    --page:           #f9f9f7;
    --text-primary:   #0b0b0b;
    --text-secondary: #52514e;
    --muted:          #898781;
    --grid:           #e1e0d9;
    --border:         rgba(11,11,11,0.10);
    --good:           #0ca30c;
    --warning:        #fab219;
    --serious:        #ec835a;
    --critical:       #d03b3b;
    --series-1:       #2a78d6;
  }}
  @media (prefers-color-scheme: dark) {{
    :root:where(:not([data-theme="light"])) .viz-root {{
      color-scheme: dark;
      --surface-1:      #1a1a19;
      --page:           #0d0d0d;
      --text-primary:   #ffffff;
      --text-secondary: #c3c2b7;
      --muted:          #898781;
      --grid:           #2c2c2a;
      --border:         rgba(255,255,255,0.10);
      --good:           #0ca30c;
      --warning:        #fab219;
      --serious:        #ec835a;
      --critical:       #e66767;
      --series-1:       #3987e5;
    }}
  }}
  * {{ box-sizing: border-box; }}
  body {{
    margin: 0; padding: 32px;
    background: var(--page);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--text-primary);
  }}
  h1 {{ font-size: 22px; margin: 0 0 4px; }}
  .meta {{ color: var(--text-secondary); font-size: 13px; margin-bottom: 28px; }}
  h2 {{ font-size: 15px; margin: 36px 0 12px; color: var(--text-primary); }}
  .tiles {{
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px; margin-bottom: 8px;
  }}
  .tile {{
    background: var(--surface-1); border: 1px solid var(--border);
    border-radius: 10px; padding: 14px 16px;
  }}
  .tile-label {{ font-size: 12px; color: var(--text-secondary); margin-bottom: 6px; }}
  .tile-value {{ font-size: 22px; font-weight: 600; font-variant-numeric: proportional-nums; }}
  .tile-sub {{ font-size: 11px; color: var(--muted); margin-top: 4px; }}
  .tile.status-good .tile-value {{ color: var(--good); }}
  .tile.status-warning .tile-value {{ color: var(--warning); }}
  .tile.status-critical .tile-value {{ color: var(--critical); }}
  table {{
    width: 100%; border-collapse: collapse; background: var(--surface-1);
    border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
    font-size: 13px;
  }}
  th {{
    text-align: left; padding: 10px 12px; color: var(--text-secondary);
    font-weight: 500; border-bottom: 1px solid var(--grid); font-size: 12px;
  }}
  td {{
    padding: 9px 12px; border-bottom: 1px solid var(--grid);
    font-variant-numeric: tabular-nums; color: var(--text-primary);
  }}
  tr:last-child td {{ border-bottom: none; }}
  .empty {{
    color: var(--muted); font-size: 13px; padding: 16px;
    background: var(--surface-1); border: 1px dashed var(--border); border-radius: 10px;
  }}
  .state-summary {{ color: var(--text-secondary); font-size: 12px; margin-top: -4px; margin-bottom: 12px; }}
  .section {{ margin-bottom: 8px; }}
</style>
</head>
<body>
<div class="viz-root">
  <h1>Claire — Bob's report</h1>
  <div class="meta">Generated {esc(now)} by Bob, read directly from desk.db. Re-run <code>bin/bob-dashboard</code> for a fresh snapshot.</div>

  <div class="tiles">{tiles}</div>

  <h2>Broker accounts</h2>
  <div class="section">{table(["Broker","Environment","Cash","Currency"], acct_rows, "No broker accounts configured yet.")}</div>

  <h2>Awaiting your approval</h2>
  <div class="section">{table(["Work item","Ticker","Kind","Expires"], pending_rows, "Nothing waiting on you right now.")}</div>

  <h2>Open positions</h2>
  <div class="section">{table(["Account","Ticker","Qty","Cost basis","Commissions"], pos_rows, "No open positions yet — Claire hasn't placed a trade on this machine.")}</div>

  <h2>P&amp;L by ticker</h2>
  <div class="section">{table(["Account","Ticker","Qty open","Open cost","Realized P&L"], pl_rows, "No P&L history yet.")}</div>

  <h2>Thesis outcomes — is she actually making money?</h2>
  <div class="section">{table(["Ticker","Kind","State","Arbiter model","Realized P&L","LLM cost"], outcome_rows, "No completed theses yet — once trades close, this table shows which model's calls made money.")}</div>

  <h2>Price alerts / stop-losses</h2>
  <div class="section">{table(["Ticker","Rule","Threshold","Status","Last fired"], alert_rows, "No alerts configured — none needed until positions are open.")}</div>

  <h2>Service health</h2>
  <div class="section">{table(["Service","Status","Detail"], health_rows, "No health pings recorded — services are likely not running.")}</div>

  <h2>Stuck / unfinished orders</h2>
  <div class="section">{table(["Order","Work item","Side","Qty","Status"], stuck_rows, "Nothing stuck — no open orders.")}</div>

  <h2>LLM cost by agent</h2>
  <div class="section">{table(["Agent","Calls","Tokens in","Tokens out","Cost"], cost_rows, "No LLM calls recorded yet.")}</div>

  <h2>Watchlist</h2>
  <div class="section">{table(["Ticker","Exchange","Note"], watch_rows, "Watchlist is empty.")}</div>

  <h2>Recent activity</h2>
  <div class="state-summary">By state: {esc(state_summary)}</div>
  <div class="section">{table(["Work item","Ticker","Kind","State","Updated"], recent_rows, "No runs recorded yet.")}</div>

</div>
</body>
</html>
"""
    OUT.write_text(html_out)
    print(f"Wrote {OUT}")


if __name__ == "__main__":
    build()
