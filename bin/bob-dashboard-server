#!/usr/bin/env python3
"""Bob's LIVE dashboard on Claire's desk.db.

A tiny stdlib-only HTTP server (no deps, matches Claire's own dashboards
style) that serves one page which polls a JSON endpoint every few seconds and
re-renders. Every poll opens a fresh READ-ONLY connection to desk.db, so it
always shows current data and never competes with Claire's own writers (WAL
mode handles concurrent readers fine).

Run it:
    ~/claire_trading/bin/bob-dashboard-server            # foreground, :7790
    ~/claire_trading/bin/bob-dashboard-server 7790 &     # background

Not installed as a service — start/stop it by hand whenever you want it up.
"""
import json
import socket
import sqlite3
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DB = REPO / "var" / "desk.db"
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 7790


def port_open(port):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.3)
    try:
        return s.connect_ex(("127.0.0.1", port)) == 0
    finally:
        s.close()


def fetch(conn, sql, params=()):
    try:
        return [dict(r) for r in conn.execute(sql, params)]
    except sqlite3.OperationalError as e:
        return {"_error": str(e)}


def build_report():
    if not DB.exists():
        return {"error": f"no desk.db at {DB}", "generated_at": time.time()}

    conn = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=2)
    conn.row_factory = sqlite3.Row
    try:
        accounts = fetch(conn, "SELECT id, broker, environment, base_currency FROM broker_accounts ORDER BY id")
        for a in accounts:
            bal = fetch(conn, "SELECT COALESCE(SUM(amount_base),0)/1e6 AS bal FROM cash_transactions WHERE account_id=?", (a["id"],))
            a["cash"] = bal[0]["bal"] if isinstance(bal, list) and bal else 0.0

        positions = fetch(conn, """
            SELECT p.account_id, i.ticker, i.currency, p.qty, p.cost_base, p.commissions
            FROM v_positions p JOIN instruments i ON i.id = p.instrument_id
            WHERE p.qty != 0 ORDER BY p.account_id, i.ticker
        """)
        share_pl = fetch(conn, """
            SELECT account_id, ticker, qty_open, open_cost, open_commissions, realized_pl
            FROM v_share_pl ORDER BY realized_pl DESC
        """)
        pending = fetch(conn, """
            SELECT id, ticker, kind, thesis_json, expires_at, created_at
            FROM work_items WHERE state='awaiting_approval' ORDER BY created_at DESC
        """)
        recent_items = fetch(conn, """
            SELECT id, ticker, kind, state, created_at, updated_at
            FROM work_items ORDER BY updated_at DESC LIMIT 20
        """)
        state_counts = fetch(conn, "SELECT state, COUNT(*) c FROM work_items GROUP BY state")
        thesis_outcomes = fetch(conn, """
            SELECT ticker, kind, state, arbiter_model, realized_pl, llm_cost
            FROM v_thesis_outcomes ORDER BY realized_pl DESC
        """)
        alerts = fetch(conn, """
            SELECT pa.id, i.ticker, pa.rule, pa.threshold, pa.armed, pa.last_fired_at
            FROM price_alerts pa JOIN instruments i ON i.id = pa.instrument_id
            ORDER BY pa.armed DESC, i.ticker
        """)
        health = fetch(conn, """
            SELECT service, checked_at, ok, detail FROM service_health
            WHERE checked_at = (SELECT MAX(checked_at) FROM service_health h2 WHERE h2.service = service_health.service)
            ORDER BY service
        """)
        stuck_orders = fetch(conn, """
            SELECT id, work_item_id, account_id, side, qty, status, expires_at
            FROM orders WHERE status IN ('pending_session','placed','partially_filled')
            ORDER BY expires_at
        """)
        cost_by_agent = fetch(conn, """
            SELECT agent_id, COUNT(*) calls, SUM(tokens_in) tin, SUM(tokens_out) tout, SUM(cost_usd) cost
            FROM agent_runs GROUP BY agent_id ORDER BY cost DESC
        """)
        watchlist = fetch(conn, "SELECT ticker, exchange, note, added_at FROM watchlist ORDER BY ticker")
    finally:
        conn.close()

    total_cash = sum(a["cash"] for a in accounts) if isinstance(accounts, list) else 0
    total_realized = sum((r["realized_pl"] or 0) for r in share_pl) if isinstance(share_pl, list) else 0
    total_cost = sum((c["cost"] or 0) for c in cost_by_agent) if isinstance(cost_by_agent, list) else 0

    return {
        "generated_at": time.time(),
        "services": {"claire_api_7788": port_open(7788), "claire_dashboards_7787": port_open(7787)},
        "stats": {
            "total_cash": total_cash,
            "total_realized_pl": total_realized,
            "open_positions": len(positions) if isinstance(positions, list) else 0,
            "pending_approvals": len(pending) if isinstance(pending, list) else 0,
            "total_llm_cost": total_cost,
        },
        "accounts": accounts,
        "positions": positions,
        "share_pl": share_pl,
        "pending": pending,
        "recent_items": recent_items,
        "state_counts": state_counts,
        "thesis_outcomes": thesis_outcomes,
        "alerts": alerts,
        "health": health,
        "stuck_orders": stuck_orders,
        "cost_by_agent": cost_by_agent,
        "watchlist": watchlist,
    }


INDEX_HTML = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Claire — Bob's live report</title>
<style>
  .viz-root {
    color-scheme: light;
    --surface-1:      #fcfcfb;
    --page:           #f9f9f7;
    --text-primary:   #0b0b0b;
    --text-secondary: #52514e;
    --muted:          #898781;
    --grid:           #e1e0d9;
    --border:         rgba(11,11,11,0.10);
    --good:           #0ca30c;
    --warning:        #fab219;
    --critical:       #d03b3b;
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .viz-root {
      color-scheme: dark;
      --surface-1:      #1a1a19;
      --page:           #0d0d0d;
      --text-primary:   #ffffff;
      --text-secondary: #c3c2b7;
      --muted:          #898781;
      --grid:           #2c2c2a;
      --border:         rgba(255,255,255,0.10);
      --good:           #0ca30c;
      --warning:        #fab219;
      --critical:       #e66767;
    }
  }
  * { box-sizing: border-box; }
  body { margin:0; padding:32px; background:var(--page); font-family: system-ui,-apple-system,"Segoe UI",sans-serif; color:var(--text-primary); }
  h1 { font-size:22px; margin:0 0 4px; }
  .meta { color:var(--text-secondary); font-size:13px; margin-bottom:8px; display:flex; gap:16px; align-items:center; flex-wrap:wrap; }
  .dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; }
  .dot.up { background:var(--good); } .dot.down { background:var(--critical); }
  h2 { font-size:15px; margin:32px 0 12px; }
  .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-top:20px; }
  .tile { background:var(--surface-1); border:1px solid var(--border); border-radius:10px; padding:14px 16px; }
  .tile-label { font-size:12px; color:var(--text-secondary); margin-bottom:6px; }
  .tile-value { font-size:22px; font-weight:600; }
  .tile.status-good .tile-value { color:var(--good); }
  .tile.status-warning .tile-value { color:var(--warning); }
  .tile.status-critical .tile-value { color:var(--critical); }
  table { width:100%; border-collapse:collapse; background:var(--surface-1); border:1px solid var(--border); border-radius:10px; overflow:hidden; font-size:13px; }
  th { text-align:left; padding:10px 12px; color:var(--text-secondary); font-weight:500; border-bottom:1px solid var(--grid); font-size:12px; }
  td { padding:9px 12px; border-bottom:1px solid var(--grid); font-variant-numeric:tabular-nums; }
  tr:last-child td { border-bottom:none; }
  .empty { color:var(--muted); font-size:13px; padding:16px; background:var(--surface-1); border:1px dashed var(--border); border-radius:10px; }
  .section { margin-bottom:8px; }
  .state-summary { color:var(--text-secondary); font-size:12px; margin:-4px 0 12px; }
</style>
</head>
<body>
<div class="viz-root">
  <h1>Claire — Bob's live report</h1>
  <div class="meta">
    <span id="asof">loading…</span>
    <span><span class="dot" id="dot-api"></span>claire-api :7788</span>
    <span><span class="dot" id="dot-dash"></span>dashboards :7787</span>
  </div>

  <div class="tiles" id="tiles"></div>

  <h2>Broker accounts</h2>
  <div class="section" id="t-accounts"></div>

  <h2>Awaiting your approval</h2>
  <div class="section" id="t-pending"></div>

  <h2>Open positions</h2>
  <div class="section" id="t-positions"></div>

  <h2>P&amp;L by ticker</h2>
  <div class="section" id="t-pl"></div>

  <h2>Thesis outcomes — is she actually making money?</h2>
  <div class="section" id="t-outcomes"></div>

  <h2>Price alerts / stop-losses</h2>
  <div class="section" id="t-alerts"></div>

  <h2>Service health</h2>
  <div class="section" id="t-health"></div>

  <h2>Stuck / unfinished orders</h2>
  <div class="section" id="t-stuck"></div>

  <h2>LLM cost by agent</h2>
  <div class="section" id="t-cost"></div>

  <h2>Watchlist</h2>
  <div class="section" id="t-watch"></div>

  <h2>Recent activity</h2>
  <div class="state-summary" id="state-summary"></div>
  <div class="section" id="t-recent"></div>
</div>

<script>
const money = v => (v === null || v === undefined) ? "-" : "$" + Number(v).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});
const esc = v => (v === null || v === undefined) ? "" : String(v).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

function tile(label, value, status, sub) {
  return `<div class="tile${status ? " status-"+status : ""}">
    <div class="tile-label">${esc(label)}</div>
    <div class="tile-value">${esc(value)}</div>
    ${sub ? `<div class="tile-sub" style="font-size:11px;color:var(--muted);margin-top:4px;">${esc(sub)}</div>` : ""}
  </div>`;
}

function table(headers, rows, emptyMsg) {
  if (!rows || !rows.length) return `<div class="empty">${esc(emptyMsg)}</div>`;
  const thead = headers.map(h => `<th>${esc(h)}</th>`).join("");
  const trs = rows.map(r => `<tr>${r.map(c => `<td>${esc(c)}</td>`).join("")}</tr>`).join("");
  return `<table><thead><tr>${thead}</tr></thead><tbody>${trs}</tbody></table>`;
}

async function refresh() {
  let d;
  try {
    const res = await fetch("/api/report");
    d = await res.json();
  } catch (e) {
    document.getElementById("asof").textContent = "fetch failed: " + e;
    return;
  }
  if (d.error) {
    document.getElementById("asof").textContent = d.error;
    return;
  }

  document.getElementById("asof").textContent = "Live — updated " + new Date(d.generated_at * 1000).toLocaleTimeString();
  document.getElementById("dot-api").className = "dot " + (d.services.claire_api_7788 ? "up" : "down");
  document.getElementById("dot-dash").className = "dot " + (d.services.claire_dashboards_7787 ? "up" : "down");

  const s = d.stats;
  document.getElementById("tiles").innerHTML = [
    tile("Total cash", money(s.total_cash), null, `across ${d.accounts.length} paper accounts`),
    tile("Realized P&L", money(s.total_realized_pl)),
    tile("Open positions", s.open_positions),
    tile("Awaiting your approval", s.pending_approvals, s.pending_approvals ? "warning" : "good"),
    tile("LLM spend to date", money(s.total_llm_cost)),
    tile("claire-api :7788", d.services.claire_api_7788 ? "up" : "down", d.services.claire_api_7788 ? "good" : "critical"),
    tile("dashboards :7787", d.services.claire_dashboards_7787 ? "up" : "down", d.services.claire_dashboards_7787 ? "good" : "critical"),
  ].join("");

  document.getElementById("t-accounts").innerHTML = table(
    ["Broker","Environment","Cash","Currency"],
    d.accounts.map(a => [a.broker, a.environment, money(a.cash), a.base_currency]),
    "No broker accounts configured yet.");

  document.getElementById("t-pending").innerHTML = table(
    ["Work item","Ticker","Kind","Expires"],
    d.pending.map(p => [p.id, p.ticker, p.kind, p.expires_at || "-"]),
    "Nothing waiting on you right now.");

  document.getElementById("t-positions").innerHTML = table(
    ["Account","Ticker","Qty","Cost basis","Commissions"],
    d.positions.map(p => [p.account_id, p.ticker, p.qty, money(p.cost_base), money(p.commissions)]),
    "No open positions yet — Claire hasn't placed a trade on this machine.");

  document.getElementById("t-pl").innerHTML = table(
    ["Account","Ticker","Qty open","Open cost","Realized P&L"],
    d.share_pl.map(r => [r.account_id, r.ticker, r.qty_open, money(r.open_cost), money(r.realized_pl)]),
    "No P&L history yet.");

  document.getElementById("t-outcomes").innerHTML = table(
    ["Ticker","Kind","State","Arbiter model","Realized P&L","LLM cost"],
    d.thesis_outcomes.map(o => [o.ticker, o.kind, o.state, o.arbiter_model || "-", money(o.realized_pl), money(o.llm_cost)]),
    "No completed theses yet — once trades close, this table shows which model's calls made money.");

  document.getElementById("t-alerts").innerHTML = table(
    ["Ticker","Rule","Threshold","Status","Last fired"],
    d.alerts.map(a => [a.ticker, a.rule, a.threshold, a.armed ? "armed" : "disarmed", a.last_fired_at || "never"]),
    "No alerts configured — none needed until positions are open.");

  document.getElementById("t-health").innerHTML = table(
    ["Service","Status","Detail"],
    d.health.map(h => [h.service, h.ok, h.detail || "-"]),
    "No health pings recorded — services are likely not running.");

  document.getElementById("t-stuck").innerHTML = table(
    ["Order","Work item","Side","Qty","Status"],
    d.stuck_orders.map(o => [o.id, o.work_item_id, o.side, o.qty, o.status]),
    "Nothing stuck — no open orders.");

  document.getElementById("t-cost").innerHTML = table(
    ["Agent","Calls","Tokens in","Tokens out","Cost"],
    d.cost_by_agent.map(c => [c.agent_id, c.calls, c.tin || 0, c.tout || 0, money(c.cost)]),
    "No LLM calls recorded yet.");

  document.getElementById("t-watch").innerHTML = table(
    ["Ticker","Exchange","Note"],
    d.watchlist.map(w => [w.ticker, w.exchange, w.note || "-"]),
    "Watchlist is empty.");

  const summary = d.state_counts.map(x => `${x.state}: ${x.c}`).join(", ") || "no runs yet";
  document.getElementById("state-summary").textContent = "By state: " + summary;

  document.getElementById("t-recent").innerHTML = table(
    ["Work item","Ticker","Kind","State","Updated"],
    d.recent_items.map(r => [r.id, r.ticker, r.kind, r.state, r.updated_at]),
    "No runs recorded yet.");
}

refresh();
setInterval(refresh, 8000);
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass  # keep stdout quiet; errors still raise

    def do_GET(self):
        if self.path == "/" or self.path == "/index.html":
            body = INDEX_HTML.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif self.path == "/api/report":
            try:
                report = build_report()
                body = json.dumps(report, default=str).encode()
                status = 200
            except Exception as e:  # noqa: BLE001 — report the error, don't crash
                body = json.dumps({"error": str(e)}).encode()
                status = 500
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(404)
            self.end_headers()


def main():
    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print(f"Bob's live Claire dashboard: http://127.0.0.1:{PORT}  (reads {DB})")
    print("Ctrl-C to stop.")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
