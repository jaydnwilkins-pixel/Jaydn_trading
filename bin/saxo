#!/usr/bin/env bash
# Read-only view of the REAL Saxo account (app/tools/saxo_live.py).
#   bin/saxo login       sign in once in the browser (OAuth + PKCE)
#   bin/saxo status      is the sign-in alive, and for how long
#   bin/saxo positions   cash + open positions
# Nothing here can place, change or cancel an order.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
set -a; . "$ROOT/etc/claire.env"; set +a
cd "$ROOT"
exec "$ROOT/venv/bin/python3" -m app.tools.saxo_cli "$@"
