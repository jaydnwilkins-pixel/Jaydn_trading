#!/usr/bin/env bash
# Read-only views of the two Saxo accounts (app/tools/saxo_live.py).
#   bin/saxo login sim|live        sign in (OAuth + PKCE, browser on this PC)
#   bin/saxo status                both sign-ins: alive, and for how long
#   bin/saxo positions [sim|live]  cash, positions, working orders
#   bin/saxo test-alert            send a test Telegram/desktop alert
# Nothing here can place, change or cancel an order.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
set -a; . "$ROOT/etc/ronathan.env"; set +a
cd "$ROOT"
exec "$ROOT/venv/bin/python3" -m app.tools.saxo_cli "$@"
