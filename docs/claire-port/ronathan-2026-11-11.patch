+function sharesFor(amount, pxBase, {lot = 1, whole = false} = {}) {
+  if (!amount || !pxBase) return 0;
+  const raw = amount / pxBase;
+  return lot > 1 ? Math.floor(raw / lot) * lot : whole ? Math.floor(raw) : Math.floor(raw * 10) / 10;
