# Copy to claire.env, chmod 600. Real keys never enter git or desk.db —
# providers reference these by NAME via api_key_ref (DESIGN.md §8).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TAVILY_API_KEY=
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
SAXO_SIM_TOKEN=
# Shared secret for :7788/internal/resume (DESIGN.md §10)
CLAIRE_INTERNAL_SECRET=
# Read-only view of the REAL Saxo account (bin/saxo login). From the live app
# registered on developer.saxo: its AppKey, and a localhost redirect URL
# registered on the app (no port), e.g. http://localhost/claire-saxo
SAXO_LIVE_APP_KEY=
SAXO_LIVE_APP_URL=http://localhost/claire-saxo
# only if the app was issued a secret (code grant rather than PKCE)
SAXO_LIVE_APP_SECRET=
