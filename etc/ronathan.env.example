# Copy to ronathan.env, chmod 600. Real keys never enter git or desk.db —
# providers reference these by NAME via api_key_ref (DESIGN.md §8).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TAVILY_API_KEY=
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
SAXO_SIM_TOKEN=
# Shared secret for :7798/internal/resume (DESIGN.md §10)
RONATHAN_INTERNAL_SECRET=
# Saxo SIM (paper): an OAuth app (PKCE) with its own sign-in
# (bin/saxo login sim), renewal and alerts. Register the redirect URL on the
# app with no port. There is no Saxo live account; to add one later, set
# SAXO_LIVE_ACCOUNT_ID, SAXO_LIVE_APP_KEY and SAXO_LIVE_APP_URL (DESIGN.md §22.4a).
SAXO_SIM_ACCOUNT_ID=
SAXO_SIM_APP_KEY=
SAXO_SIM_APP_URL=http://localhost/ronathan-saxo
# only for an app with grant type "code" (PKCE needs no secret)
SAXO_SIM_APP_SECRET=

# ── Saxo SIM execution (paper money, real Saxo order handling) ─────────────
# Route the saxo-paper account to Saxo SIM instead of the in-process sim.
SAXO_SIM_EXECUTION=
SAXO_SIM_ACCOUNT_KEY=

# ── REAL-MONEY trading on Saxo — DESIGN.md §22. Leave empty to keep it off.
# Setting this alone trades nothing: you must also `bin/ronathan live setup`,
# `bin/ronathan live arm` (terminal, typed confirmation) and approve each trade
# by typing LIVE. Remove it and restart to switch live trading off entirely.
RONATHAN_LIVE_TRADING=
