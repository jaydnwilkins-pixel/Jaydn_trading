[Unit]
Description=Ronathan trading desk (bin/ronathan start/stop wrapper)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/jaydn/jaydn_trading
# Keep the drain budget and the stop timeout side by side: bin/ronathan reads
# RONATHAN_DRAIN_TIMEOUT (wall-clock seconds) and TimeoutStopSec must exceed it
# plus the TERM→KILL wait in `ronathan stop` (15 s + 2 s) and the schedule
# restore (a few s). 300 + ~25 s overhead → 420 s leaves ~95 s of margin.
# If you raise one, raise the other.
Environment=RONATHAN_DRAIN_TIMEOUT=300
ExecStart=/home/jaydn/jaydn_trading/bin/ronathan start
ExecStop=/home/jaydn/jaydn_trading/bin/ronathan stop --graceful
TimeoutStopSec=420
# mixed: on a stop timeout SIGTERM goes only to the ExecStop script, whose
# trap restores the paused schedules and exits; its helper processes (the
# python that writes desk.db) are not killed underneath it. Whatever of the
# desk is still alive afterwards gets SIGKILL — safe, every book write is
# committed synchronously (same contract as `ronathan stop --kill`).
KillMode=mixed

[Install]
WantedBy=default.target
